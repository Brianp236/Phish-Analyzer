# Copy to secrets.env, fill in, then load with:  set -a; source secrets.env; set +a
# secrets.env is in .gitignore. Never commit it.
VT_API_KEY=your-virustotal-api-key
GMAIL_USER=analyzer-inbox@example.com

# Optional: link fetching
# LINKFETCH_HEADLESS=0          # show the browser window while fetching links
# LINKFETCH_CHROMIUM=/path/to/chromium

# Optional: AI incident report (Stage 5). Pick one backend; the default is a template with no AI.
# AI_BACKEND=claude-code        # uses a logged-in Claude Code CLI, tools disabled
# CLAUDE_CODE_MODEL=sonnet
# AI_BACKEND=claude             # uses the Claude API (default when ANTHROPIC_API_KEY is set)
# ANTHROPIC_API_KEY=your-key
# AI_REPORT_MODEL=
# AI_BACKEND=ollama             # free, local
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
